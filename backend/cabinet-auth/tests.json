{
  "tests": [
    {
      "name": "Без токена возвращает 401",
      "method": "GET",
      "path": "/?action=me",
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Пустой пароль не пускает",
      "method": "POST",
      "path": "/?action=check-code",
      "body": {"code": ""},
      "expectedStatus": 400,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Неверный пароль группы отклоняется",
      "method": "POST",
      "path": "/?action=check-code",
      "body": {"code": "zzz-nonexistent-group-999"},
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "PIN без билета входа отклоняется",
      "method": "POST",
      "path": "/?action=login-pin",
      "body": {"ticket": "invalid", "pin": "1234"},
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    }
  ]
}
